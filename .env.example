# Neon PostgreSQL
DATABASE_URL=

# Integration tokens
# Use new, independent random secrets in the source app and in VDC Club.
VDC_TC_SYNC_TOKEN=
VDC_TURNIER_SYNC_TOKEN=
VDC_TRAINING_SYNC_TOKEN=

# Schützt den automatischen Vercel-Sync-Cron. Zufälligen Secret-Wert in Production setzen.
CRON_SECRET=

# Optional: nur setzen, wenn die Produktions-URLs der Fach-Apps abweichen.
VDC_TC_SOURCE_URL=https://vdc-tc.vercel.app/api/integrations/vdc-club
VDC_TURNIER_SOURCE_URL=https://vdc-turnier.vercel.app/api/integrations/vdc-club
VDC_TRAINING_SOURCE_URL=https://vdc-training-app.vercel.app/api/integrations/vdc-club

# Neon Object Storage (private document bucket)
DOCUMENT_STORAGE_BUCKET=documents
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=eu-central-1

# Document storage variables are configured as server-only environment variables in Vercel.
